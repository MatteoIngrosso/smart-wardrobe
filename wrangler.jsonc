// Cloudflare Workers settings. Every push to main deploys the app (see README, "Putting it online").
{
  "name": "smart-wardrobe",
  "main": "worker/api.js",
  "compatibility_date": "2026-09-01",
  // The app itself: plain files from this folder, minus what's listed in .assetsignore.
  // Every request goes through the Worker first, so nothing is shown before you sign in.
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": true },
  // The shared wardrobe. Cloudflare creates the database on the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "smart-wardrobe" }],
  // Free try-on pictures (FLUX.2 klein on Workers AI): 10,000 neurons a day on the free plan, never charged.
  "ai": { "binding": "AI" },
  // Keep variables added in the dashboard across deploys (secrets are always kept).
  "keep_vars": true,
  "workers_dev": true,
  // No extra preview addresses: only the main address, behind the sign-in.
  "preview_urls": false
}
