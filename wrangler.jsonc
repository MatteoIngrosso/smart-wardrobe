// Cloudflare Workers settings. Every push to main deploys the app (see README, "Putting it online").
{
  "name": "smart-wardrobe",
  "main": "worker/api.js",
  "compatibility_date": "2026-09-01",
  // The app itself: plain files from this folder, minus what's listed in .assetsignore.
  // Only /api/* runs the Worker; everything else is served straight from Cloudflare's cache.
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // The shared wardrobe. Cloudflare creates the database on the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "smart-wardrobe" }],
  // ACCESS_TEAM and ACCESS_AUD are set in the dashboard; keep them across deploys.
  "keep_vars": true,
  "workers_dev": true,
  // No extra preview addresses: only the main address, behind the sign-in.
  "preview_urls": false
}
